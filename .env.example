# ==============================================================================
# Medikiosk OCR Microservice - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# - NEVER commit the real '.env' file or any file containing real credentials to Git.
# - NEVER commit Google/Firebase service account JSON files or private keys.
# - SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security (RLS); it must ONLY be used
#   in secure backend environments (like this microservice) and NEVER exposed to clients.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME=Medikiosk OCR
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# CORS / Security
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (e.g. Vite frontend)
ALLOWED_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# Firebase Authentication & Firestore (Planned - Phase 4)
# ------------------------------------------------------------------------------
# In local development: path to your local service account JSON file (git-ignored)
# e.g., GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# On Render: Provide via environment secret or base64-encoded environment variable.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# Supabase Private Storage (Planned - Phase 3)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=
# Service role key with administrative access to read private storage bucket
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket storing prescription images
SUPABASE_BUCKET_NAME=patient-document
